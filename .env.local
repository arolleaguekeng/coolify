# Coolify Configuration - Local Development (No Docker)
APP_ENV=local
APP_NAME="Coolify Local"
APP_ID=local
APP_KEY=base64:OE6oFcIUJDK0hozJJHf6TPNXQ73DykgK3xDjYS8+k40=
APP_URL=http://localhost:8000
APP_PORT=8000
APP_DEBUG=true
SSH_MUX_ENABLED=false

# PostgreSQL Database Configuration (Local)
DB_CONNECTION=pgsql
DB_DATABASE=coolify
DB_USERNAME=pharaon
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis Configuration (Local)
REDIS_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Pusher/Soketi Configuration (will run separately)
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_ID=coolify
PUSHER_APP_KEY=coolify
PUSHER_APP_SECRET=coolify

# Queue Configuration
QUEUE_CONNECTION=redis
HORIZON_BALANCE=auto
HORIZON_MAX_PROCESSES=10
HORIZON_BALANCE_MAX_SHIFT=1
HORIZON_BALANCE_COOLDOWN=3

# Session & Cache
SESSION_DRIVER=redis
CACHE_DRIVER=redis

# Mail Configuration (use log driver for local)
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@coolify.io
MAIL_FROM_NAME="${APP_NAME}"

# Disable features that require Docker
DOCKER_ENABLED=false

# Ray Configuration (optional debugging)
RAY_ENABLED=false

# Telescope (optional debugging)
TELESCOPE_ENABLED=true
